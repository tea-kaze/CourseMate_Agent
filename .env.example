# ================= 模型配置 =================
# 主模型：DeepSeek（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ================= Embedding 配置（硅基流动）=================
# 从 https://cloud.siliconflow.cn 获取
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ================= 存储配置 =================
# 默认 SQLite（本地运行零依赖）；切换到 PostgreSQL 时取消注释并填入连接串
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/coursemate

# Milvus：默认本地文件模式（Milvus Lite）；使用 Docker 版 Milvus 时改为
# MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=
MILVUS_URI=./data/milvus_lite.db
MILVUS_COLLECTION=coursemate_kb

# ================= 存储路径 =================
UPLOAD_DIR=data/uploads

# ================= 可观测性（LangSmith，可选）=================
# 从 https://smith.langchain.com 获取 API Key；设置后把 LANGSMITH_TRACING 改为 true
# 即可自动记录每次问答/出题/批改的 trace（含 tool call、检索结果、token、耗时）
LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxx
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=coursemate
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
