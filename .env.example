# ================= 模型配置 =================
# 主模型：DeepSeek（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ================= Embedding 配置（硅基流动）=================
# 从 https://cloud.siliconflow.cn 获取
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ================= 存储配置 =================
# 运行时数据库：必填，只接受 PostgreSQL（裸 postgresql:// 会规范化为 psycopg）
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/coursemate
# 自动化测试必须使用独立的 *_test 数据库，禁止与 DATABASE_URL 指向同一数据库
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/coursemate_test

# 向量库：必填，只接受 Docker/远程 Milvus 的 http(s) 地址，不支持本地文件路径
MILVUS_URI=http://localhost:19530
# 本地 Docker 默认留空；托管 Milvus 按供应商要求填写 token
MILVUS_TOKEN=
MILVUS_COLLECTION=coursemate_kb

# ================= 存储路径 =================
UPLOAD_DIR=data/uploads
# 单个上传文件大小上限（MB，按 1024 * 1024 字节计算）
MAX_UPLOAD_MB=50

# ================= 可观测性（LangSmith，可选）=================
# 从 https://smith.langchain.com 获取 API Key；设置后把 LANGSMITH_TRACING 改为 true
# 即可自动记录每次问答/出题/批改的 trace（含 tool call、检索结果、token、耗时）
LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxx
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=coursemate
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
